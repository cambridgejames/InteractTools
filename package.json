{
  "name": "interact-tools",
  "version": "0.1.0",
  "private": true,
  "description": "互动工坊：直播间弹幕互动工具集",
  "keywords": [
    "electron",
    "vue",
    "bilibili",
    "danmaku",
    "live-stream",
    "interaction"
  ],
  "main": "./out/main/index.js",
  "author": "CambridgeJames",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgejames/InteractTools.git"
  },
  "bugs": {
    "url": "https://github.com/cambridgejames/InteractTools/issues"
  },
  "homepage": "https://github.com/cambridgejames/InteractTools#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && npm run check:boundaries && npm run check:design",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "npm run build && node scripts/launch-electron.mjs . --smoke",
    "package:win": "npm run build && electron-builder --win --x64",
    "check:design": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
